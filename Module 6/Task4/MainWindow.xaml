<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт финансов" Width="780" Height="460" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Элемент DataGrid: таблица финансовых записей; AutoGenerateColumns=False означает, что столбцы заданы вручную ниже; IsReadOnly=True запрещает правку прямо в таблице; Binding указывает свойство класса FinanceRecord, которое показывает столбец; StringFormat=dd.MM.yyyy выводит дату в виде день.месяц.год -->
        <DataGrid x:Name="grid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Элемент Grid с колонками: ряд подписей и полей ввода; каждая пара «подпись + поле» лежит в своём StackPanel (элементы друг под другом) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Дата"/>
                <DatePicker x:Name="datePicker" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Тип"/>
                <!-- Элемент ComboBox: выпадающий список; IsEditable=False запрещает вводить свой текст, можно только выбрать вариант; варианты задаются в коде MainWindow.xaml.cs -->
                <ComboBox x:Name="typeBox" Margin="0,3,0,0" Padding="4,3" IsEditable="False"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="Категория"/>
                <TextBox x:Name="categoryBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Сумма"/>
                <TextBox x:Name="amountBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="addButton" Content="Добавить" Width="120" Height="32" Margin="0,0,8,0" Click="addButton_Click"/>
            <Button x:Name="updateButton" Content="Изменить" Width="120" Height="32" Click="updateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
