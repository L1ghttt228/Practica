<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Width="780" Height="460" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Элемент StackPanel с Orientation=Horizontal: подпись и поле поиска в одной строке; событие TextChanged вызывает метод searchBox_TextChanged при каждом изменении текста -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="searchBox" Width="300" Padding="2" TextChanged="searchBox_TextChanged"/>
        </StackPanel>

        <!-- Элемент DataGrid: таблица книг; AutoGenerateColumns=False означает, что столбцы заданы вручную ниже; IsReadOnly=True запрещает правку прямо в таблице; Binding указывает свойство класса Book, которое показывает столбец, а Mode=OneWay означает, что данные только читаются -->
        <DataGrid x:Name="grid" Grid.Row="1" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author, Mode=OneWay}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status, Mode=OneWay}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Элемент TextBox: поле для ввода имени читателя, которое записывается в книгу при аренде -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Left">
            <TextBlock Text="Имя читателя"/>
            <TextBox x:Name="readerBox" Width="250" Margin="0,3,0,0" Padding="2"/>
        </StackPanel>

        <!-- Элементы Button: кнопки аренды и возврата; атрибут Click указывает метод-обработчик из MainWindow.xaml.cs, который вызывается при нажатии -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="rentButton" Content="Арендовать" Width="120" Height="32" Margin="0,0,8,0" Click="rentButton_Click"/>
            <Button x:Name="returnButton" Content="Вернуть" Width="120" Height="32" Click="returnButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
