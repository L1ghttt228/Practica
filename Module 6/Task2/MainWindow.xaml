<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт задач" Width="780" Height="460" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Элемент DataGrid: таблица задач; AutoGenerateColumns=False означает, что столбцы заданы вручную ниже; IsReadOnly=True запрещает правку прямо в таблице; Binding указывает свойство класса TaskItem, которое показывает столбец; Width=* занимает всё свободное место, а число задаёт ширину в пикселях -->
        <DataGrid x:Name="grid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="220"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Элемент Grid с колонками: ряд подписей и полей ввода; каждая пара «подпись + поле» лежит в своём StackPanel (элементы друг под другом) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Название"/>
                <TextBox x:Name="titleBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Описание"/>
                <TextBox x:Name="descriptionBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус"/>
                <!-- Элемент ComboBox: выпадающий список; IsEditable=False запрещает вводить свой текст, можно только выбрать вариант; варианты задаются в коде MainWindow.xaml.cs -->
                <ComboBox x:Name="statusBox" Margin="0,3,0,0" Padding="4,3" IsEditable="False"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="addButton" Content="Добавить" Width="120" Height="32" Margin="0,0,8,0" Click="addButton_Click"/>
            <Button x:Name="updateButton" Content="Изменить" Width="120" Height="32" Margin="0,0,8,0" Click="updateButton_Click"/>
            <Button x:Name="deleteButton" Content="Удалить" Width="120" Height="32" Click="deleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
