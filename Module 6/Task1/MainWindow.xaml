<Window x:Class="EmployeeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт сотрудников" Width="780" Height="460" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Элемент DataGrid: таблица сотрудников; AutoGenerateColumns=False означает, что столбцы заданы вручную ниже; IsReadOnly=True запрещает правку прямо в таблице; Binding указывает свойство класса Employee, которое показывает столбец; Width=* занимает всё свободное место, а число задаёт ширину в пикселях -->
        <DataGrid x:Name="grid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*"/>
                <DataGridTextColumn Header="Оклад" Binding="{Binding Salary}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Элемент Grid с колонками: ряд подписей и полей ввода; каждая пара «подпись + поле» лежит в своём StackPanel (элементы друг под другом) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="ФИО"/>
                <TextBox x:Name="nameBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Должность"/>
                <TextBox x:Name="positionBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="Отдел"/>
                <TextBox x:Name="departmentBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Оклад"/>
                <TextBox x:Name="salaryBox" Margin="0,3,0,0" Padding="2"/>
            </StackPanel>
        </Grid>

        <!-- Элементы Button: кнопки; атрибут Click указывает метод-обработчик из MainWindow.xaml.cs, который вызывается при нажатии -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="addButton" Content="Добавить" Width="120" Height="32" Margin="0,0,8,0" Click="addButton_Click"/>
            <Button x:Name="updateButton" Content="Изменить" Width="120" Height="32" Margin="0,0,8,0" Click="updateButton_Click"/>
            <Button x:Name="deleteButton" Content="Удалить" Width="120" Height="32" Click="deleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
